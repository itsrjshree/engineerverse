rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Admin identity is tied to a Firebase custom claim (`admin: true`),
      // synced server-side (see server/services/firestoreService.js
      // syncAdminClaim()) only when a user's UID matches the server-side
      // ADMIN_FIREBASE_UID env var AND their email/emailVerified match the
      // authorized admin account. A raw email string on the auth token is
      // NEVER trusted directly here — email alone must never grant admin
      // privileges, since it is not itself proof of the authorized identity.
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. User Profiles & Engineer Profiles
    match /users/{userId} {
      // READ: authenticated users may read user documents (needed for e.g.
      // displaying public-ish profile info in-app). Consider narrowing this
      // further to owner+admin only if full user documents should not be
      // broadly listable — tracked as a follow-up, not changed here since
      // some existing UI may depend on the current broader read.
      allow read: if isAuthenticated();

      // WRITE: client writes are intentionally disallowed entirely.
      // users/{uid} contains privileged fields (role, isAdmin, status,
      // connectionCredits) alongside self-editable ones (displayName, bio,
      // discipline, portfolioUrl, photoURL) in the SAME document, so an
      // owner-based write rule cannot safely be field-scoped without
      // request.resource.data.diff() checks on every field individually.
      // All legitimate mutations already go through the backend (Admin SDK,
      // which bypasses these rules entirely) via PUT /api/auth/profile
      // (self-editable fields) and the /api/admin/users/:uid/* endpoints
      // (privileged fields, requireAdmin-protected). A direct client write
      // here would previously have let any authenticated owner self-grant
      // role: 'admin' / isAdmin: true / unlimited connectionCredits.
      allow write: if false;
    }

    match /engineerProfiles/{userId} {
      allow read: if true; // Public directory profiles
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Credits Ledger & Transactions (Authoritative Server Managed)
    match /creditAccounts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /creditTransactions/{txId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 3. Engineering DNA Sessions & Results
    match /dnaSessions/{sessionId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid) || isAdmin();
    }

    match /dnaResults/{resultId} {
      allow read: if true; // Shareable results
      allow create: if true; // Public/guest generation allowed
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // 4. The Problem Wall, Solutions & Supports
    match /problems/{problemId} {
      allow read: if true; // Public view
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin();

      match /solutions/{solutionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.solverUid == request.auth.uid);
      }
    }

    match /problemSolutions/{solutionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.solverUid == request.auth.uid);
    }

    match /problemSupports/{supportId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // 5. Stories, Pledges & Counters
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /storyUpvotes/{upvoteId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    match /pledges/{pledgeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /systemCounters/{counterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /manifests/{manifestId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Missions & Challenges
    match /missions/{missionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challengeSubmissions/{submissionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Featured Content & Editorial Controls (Admin Only Write)
    match /featuredContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Telemetry & Analytics Events
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 9. AI Usage & Diagnostics
    match /aiUsage/{docId} {
      allow read, write: if isAdmin();
    }

    // 10. Media Registry & Assets
    match /mediaAssets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mediaRegistry/{sha256} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Administrative Audit Logs & Moderation
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /moderationQueue/{itemId} {
      allow read, write: if isAdmin();
    }
  }
}
