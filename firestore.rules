rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'rajshreeakm@gmail.com';
    }

    // 1. User Profiles & Engineer Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /engineerProfiles/{userId} {
      allow read: if true; // Public directory profiles
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Engineering DNA Sessions & Results
    match /dnaSessions/{sessionId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid) || isAdmin();
    }

    match /dnaResults/{resultId} {
      allow read: if true; // Shareable results
      allow create: if true; // Public/guest generation allowed
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // 3. The Problem Wall & Supports (Unlimited Architecture)
    match /problems/{problemId} {
      allow read: if true; // Public view
      allow create: if true; // Visitors can submit problems
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /problemSupports/{supportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // 4. Missions & Challenges
    match /missions/{missionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challengeSubmissions/{submissionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Stories & Pledges
    match /stories/{storyId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /pledges/{pledgeId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /manifests/{manifestId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Featured Content & Editorial Controls (Admin Only Write)
    match /featuredContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Telemetry & Analytics Events (Append-only / Public tracking)
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 8. AI Usage & Diagnostics (Strictly Admin or Cloud Function)
    match /aiUsage/{docId} {
      allow read, write: if isAdmin();
    }

    // 9. Administrative Audit Logs & Moderation Records (Strictly Admin)
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /moderationQueue/{itemId} {
      allow read, write: if isAdmin();
    }
  }
}
