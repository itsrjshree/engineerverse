{
  "entities": {
    "users": {
      "title": "users",
      "description": "Canonical user accounts and engineer profiles in ENGINEERVERSE",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase UID (document key)" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "emailVerified": { "type": "boolean", "description": "Whether the email is verified" },
        "provider": { "type": "string", "description": "Auth provider identifier" },
        "displayName": { "type": "string", "description": "Engineer display name" },
        "bio": { "type": "string", "description": "Engineering bio and philosophy" },
        "discipline": { "type": "string", "description": "Primary engineering discipline" },
        "portfolioUrl": { "type": "string", "description": "Personal or project portfolio URL" },
        "photoURL": { "type": "string", "nullable": true, "description": "Cloudinary CDN avatar URL" },
        "photoMetadata": {
          "type": "object",
          "nullable": true,
          "properties": {
            "publicId": { "type": "string" },
            "url": { "type": "string" },
            "updatedAt": { "type": "string" }
          },
          "description": "Cloudinary asset reference and tracking metadata"
        },
        "role": { "type": "string", "enum": ["admin", "member"], "description": "Platform role" },
        "isAdmin": { "type": "boolean", "description": "Administrative authority flag" },
        "status": { "type": "string", "enum": ["active", "warned", "suspended", "blocked"], "description": "Account status" },
        "warningReason": { "type": "string", "nullable": true },
        "warnedAt": { "type": "string", "nullable": true },
        "suspendedReason": { "type": "string", "nullable": true },
        "suspendedAt": { "type": "string", "nullable": true },
        "blockedReason": { "type": "string", "nullable": true },
        "blockedAt": { "type": "string", "nullable": true },
        "connectionCredits": { "type": "number", "description": "Available connection credits" },
        "problemsCount": { "type": "number", "description": "Total engineering problems posted" },
        "solutionsCount": { "type": "number", "description": "Total solutions contributed" },
        "supportsCount": { "type": "number", "description": "Total problems supported" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "lastActiveAt": { "type": "string", "description": "ISO timestamp of last activity" }
      },
      "required": ["uid", "email", "role", "status", "connectionCredits", "createdAt", "updatedAt"]
    },
    "creditAccounts": {
      "title": "creditAccounts",
      "description": "Authoritative atomic credit balance ledger per user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "balance": { "type": "number" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "balance", "updatedAt"]
    },
    "creditTransactions": {
      "title": "creditTransactions",
      "description": "Immutable ledger of all credit additions, deductions, and exemptions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "balanceAfter": { "type": "number" },
        "description": { "type": "string" },
        "referenceId": { "type": "string", "nullable": true },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "uid", "amount", "type", "balanceAfter", "createdAt"]
    },
    "problems": {
      "title": "problems",
      "description": "Authoritative engineering challenges on The Problem Wall",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "affectedUsers": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "isResolved": { "type": "boolean" },
        "supportersCount": { "type": "number" },
        "solutionsCount": { "type": "number" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "description", "status", "authorUid", "createdAt"]
    },
    "problemSolutions": {
      "title": "problemSolutions",
      "description": "Solution proposals submitted by engineers to solve specific community challenges",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "problemId": { "type": "string" },
        "solverUid": { "type": "string" },
        "solverName": { "type": "string" },
        "solverEmail": { "type": "string" },
        "solverBio": { "type": "string" },
        "solverDiscipline": { "type": "string" },
        "portfolioUrl": { "type": "string" },
        "proposedSolution": { "type": "string" },
        "contactPitch": { "type": "string" },
        "estimatedTimeline": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "connected", "declined"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "problemId", "solverUid", "proposedSolution", "status", "createdAt"]
    },
    "stories": {
      "title": "stories",
      "description": "Community engineering stories and lessons learned",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "discipline": { "type": "string" },
        "quote": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "featured": { "type": "boolean" },
        "upvotes": { "type": "number" },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "discipline", "quote", "status", "createdAt"]
    },
    "pledges": {
      "title": "pledges",
      "description": "Engineering pledges connecting Sir MV's legacy with modern builders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "commitment": { "type": "string" },
        "certificateId": { "type": "string" },
        "signedAt": { "type": "string" },
        "signerUid": { "type": "string", "nullable": true },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "commitment", "certificateId", "signedAt"]
    },
    "auditLogs": {
      "title": "auditLogs",
      "description": "Administrative and security audit trails",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actorId": { "type": "string" },
        "targetUid": { "type": "string", "nullable": true },
        "details": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "actorId", "timestamp"]
    },
    "missions": {
      "title": "missions",
      "description": "Societal engineering missions, blueprints, and real-world specs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "pillar": { "type": "string" },
        "impact": { "type": "string" },
        "difficulty": { "type": "string" },
        "objective": { "type": "string" },
        "specifications": { "type": "array", "items": { "type": "string" } },
        "disciplines": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "pillar", "objective"]
    },
    "problemSupports": {
      "title": "problemSupports",
      "description": "Verified community engineer support votes for problems",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "problemId": { "type": "string" },
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "problemId", "uid", "createdAt"]
    },
    "mediaAssets": {
      "title": "mediaAssets",
      "description": "Audit registry for uploaded media assets and avatar image assets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "publicId": { "type": "string", "nullable": true },
        "ownerUid": { "type": "string" },
        "sha256": { "type": "string" },
        "provider": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "replaced", "deleted"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "url", "ownerUid", "sha256", "provider", "status"]
    },
    "systemCounters": {
      "title": "systemCounters",
      "description": "Authoritative aggregated counters for rapid queries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalUsers": { "type": "number" },
        "totalProblems": { "type": "number" },
        "totalSolutions": { "type": "number" },
        "totalSupports": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "updatedAt"]
    }
  },
  "firestoreRules": "firestore.rules"
}
