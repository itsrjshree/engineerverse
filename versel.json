{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/engineerverse/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/engineerverse/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/engineerverse",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
